#!/usr/bin/env -S bun --no-env-file --config=/dev/null
/** Outside-review launcher. macOS uses ONE authoritative Seatbelt sandbox.
 * Native off is never a fallback: every Grok process runs inside sandbox-exec.
 * Linux retains Grok's native read-only profile. See docs/specs/2026-10-07-grok-read-only-launcher.md.
 */
import * as fs from 'node:fs';
import * as path from 'node:path';

const VERIFIED_BUILD = 'grok 1.0.44 (5b807183dd79) [stable]';
const TRUST_FILES = [
  'config.toml',
  'trusted_folders.toml',
  'managed_config.toml',
  'requirements.toml',
  'sandbox.toml',
  'hooks-paths',
];
function fail(message: string): never {
  throw new Error(message);
}
function options(argv: string[]) {
  const values = new Map<string, string>();
  let continuing = false;
  for (let i = 0; i < argv.length; i++) {
    const key = argv[i];
    if (key === '--continue' && !continuing) {
      continuing = true;
      continue;
    }
    if (
      ![
        '--mode',
        '--cwd',
        '--prompt-file',
        '--model',
        '--effort',
        '--max-turns',
      ].includes(key) ||
      values.has(key)
    )
      fail(`unsupported or duplicate argument: ${key}`);
    const value = argv[++i];
    if (!value || value.startsWith('--')) fail(`missing value for ${key}`);
    values.set(key, value);
  }
  const mode = values.get('--mode');
  if (!['review', 'challenge', 'consult'].includes(mode || ''))
    fail('--mode must be review, challenge or consult');
  for (const key of ['--cwd', '--prompt-file'])
    if (!values.get(key)) fail(`${key} is required`);
  const model = values.get('--model');
  if (model && !/^[A-Za-z0-9._:-]+$/.test(model)) fail('invalid model id');
  const effort = values.get('--effort');
  if (effort && !['minimal', 'low', 'medium', 'high', 'xhigh'].includes(effort))
    fail('invalid effort');
  const turns = values.get('--max-turns') || (mode === 'consult' ? '8' : '3');
  if (!/^[1-9][0-9]*$/.test(turns) || Number(turns) > 8)
    fail('max-turns must be between 1 and 8');
  const cwd = fs.realpathSync(values.get('--cwd')!);
  if (!fs.statSync(cwd).isDirectory()) fail('cwd must be a directory');
  const prompt = fs.realpathSync(values.get('--prompt-file')!);
  if (!fs.statSync(prompt).isFile()) fail('prompt-file must be a regular file');
  const args = [
    '--no-auto-update',
    '--no-alt-screen',
    '--no-leader',
    '--no-subagents',
    '--permission-mode',
    'plan',
    '--disable-web-search',
    '--cwd',
    cwd,
    '--max-turns',
    turns,
    '--output-format',
    'plain',
    '--prompt-file',
    prompt,
  ];
  if (mode === 'consult')
    args.push(
      '--tools',
      'Read,Glob,Grep',
      '--disallowed-tools',
      'search_tool,use_tool',
      '--deny',
      'mcp__*',
    );
  else args.push('--deny', '*');
  if (model) args.push('--model', model);
  if (effort) args.push('--effort', effort);
  if (continuing) args.push('--continue');
  return { cwd, args };
}
function overlaps(a: string, b: string) {
  return a === b || a.startsWith(b + '/') || b.startsWith(a + '/');
}
// A protected source may not redirect protection through a symlink, nor have a
// hard-link alias writable through state/temp. Missing default slots are denied too.
function validateSource(source: string, directory?: boolean, required = false) {
  if (!path.isAbsolute(source))
    fail(`protected source must be absolute: ${source}`);
  let current = path.parse(source).root;
  for (const part of source.split(path.sep).filter(Boolean)) {
    current = path.join(current, part);
    let st: fs.Stats;
    try {
      st = fs.lstatSync(current);
    } catch (error: any) {
      if (error.code === 'ENOENT' && !required) return;
      throw error;
    }
    if (st.isSymbolicLink()) fail(`protected source has a symlink: ${current}`);
    if (current !== source && !st.isDirectory())
      fail(`protected parent is not a directory: ${current}`);
    if (
      current === source &&
      directory !== undefined &&
      (directory ? !st.isDirectory() : !st.isFile())
    )
      fail(`invalid protected source type: ${source}`);
    if (st.isFile() && st.nlink !== 1)
      fail(`protected source has hard-link aliases: ${current}`);
  }
}
function protectTree(root: string) {
  validateSource(root, true);
  if (!fs.existsSync(root)) return;
  for (const entry of fs.readdirSync(root)) {
    const name = path.join(root, entry);
    validateSource(name);
    const st = fs.lstatSync(name);
    if (st.isDirectory()) protectTree(name);
    else if (!st.isFile()) fail(`invalid hook source type: ${name}`);
  }
}
function aliases(source: string) {
  const paths = [source];
  for (const prefix of ['/var', '/tmp', '/etc'])
    if (
      source === '/private' + prefix ||
      source.startsWith('/private' + prefix + '/')
    )
      paths.push(source.slice('/private'.length));
  return paths;
}
function quote(value: string) {
  return JSON.stringify(value);
}
function policy(cwd: string, binary: string, state: string) {
  validateSource(state, true, true);
  if (overlaps(state, cwd)) fail('Grok state and workspace roots overlap');
  const protectedPaths = TRUST_FILES.map((file) => path.join(state, file));
  for (const file of protectedPaths) validateSource(file, false);
  const hooks = path.join(state, 'hooks');
  protectTree(hooks);
  protectedPaths.push(hooks);
  const registry = path.join(state, 'hooks-paths');
  if (fs.existsSync(registry))
    for (const line of fs.readFileSync(registry, 'utf8').split('\n')) {
      const source = line.trim();
      if (!source || !path.isAbsolute(source)) continue;
      validateSource(source, undefined, true);
      const type = fs.statSync(source);
      if (type.isDirectory()) protectTree(source);
      else if (!type.isFile())
        fail(`invalid hook registry target type: ${source}`);
      protectedPaths.push(source);
    }
  const temporary = Bun.spawnSync(
    ['/usr/bin/getconf', 'DARWIN_USER_TEMP_DIR'],
    { stdout: 'pipe', stderr: 'pipe' },
  );
  if (temporary.exitCode !== 0)
    fail('cannot resolve system temporary directory');
  const temp = fs.realpathSync(temporary.stdout.toString().trim());
  const tmp = fs.realpathSync('/tmp'),
    varTmp = fs.realpathSync('/var/tmp');
  const lines = ['(version 1)', '(allow default)', '(deny file-write*)'];
  for (const root of new Set([state, temp, tmp, varTmp]))
    lines.push(`(allow file-write* (subpath ${quote(root)}))`);
  for (const device of [
    '/dev/null',
    '/dev/zero',
    '/dev/random',
    '/dev/urandom',
    '/dev/tty',
    '/dev/ptmx',
  ])
    lines.push(`(allow file-write-data (literal ${quote(device)}))`);
  lines.push('(allow file-write-data (subpath "/dev/fd"))');
  const launcher = fs.realpathSync(import.meta.path),
    bun = fs.realpathSync(process.execPath);
  for (const source of new Set(
    [cwd, launcher, bun, binary, ...protectedPaths].flatMap(aliases),
  )) {
    lines.push(
      `(deny file-write* (literal ${quote(source)}) (subpath ${quote(source)}))`,
    );
    // Renaming an ancestor could redirect a path-based deny. Pin each ancestor,
    // but allow creation of unrelated children in the permitted state/temp roots.
    let parent = path.dirname(source);
    while (parent !== '/') {
      lines.push(`(deny file-write* (literal ${quote(parent)}))`);
      parent = path.dirname(parent);
    }
  }
  // File denies do NOT block direct AF_UNIX connects. Deny the socket class,
  // avoiding a resolution race for aliases, replaced sockets and new endpoints.
  lines.push('(deny network-outbound (remote unix-socket))');
  for (const dns of [
    '/var/run/mDNSResponder',
    '/private/var/run/mDNSResponder',
  ]) {
    if (!fs.existsSync(dns)) continue;
    const real = path.join(
        fs.realpathSync(path.dirname(dns)),
        path.basename(dns),
      ),
      st = fs.lstatSync(real);
    if (
      !st.isSocket() ||
      st.uid !== 0 ||
      real !== '/private/var/run/mDNSResponder'
    )
      fail('unexpected system DNS endpoint');
    lines.push(`(allow network-outbound (literal ${quote(dns)}))`);
  }
  return { text: lines.join('\n'), temp };
}
async function capture(
  cmd: string[],
  cwd: string,
  env: Record<string, string | undefined>,
) {
  const p = Bun.spawn(cmd, {
    cwd,
    env,
    stdin: 'ignore',
    stdout: 'pipe',
    stderr: 'pipe',
  });
  const [code, out] = await Promise.all([
    p.exited,
    new Response(p.stdout).text(),
    new Response(p.stderr).text(),
  ]);
  if (code !== 0)
    fail(`Grok preflight failed (exit ${code}); no session started`);
  return out;
}
async function main() {
  const { cwd, args } = options(process.argv.slice(2));
  if (!['darwin', 'linux'].includes(process.platform))
    fail(`unsupported platform: ${process.platform}`);
  const candidate = process.env.GSTACK_GROK_BIN || Bun.which('grok');
  if (!candidate) fail('grok executable not found');
  const binary = fs.realpathSync(candidate);
  if (!fs.statSync(binary).isFile())
    fail('grok executable must be a regular file');
  const env: Record<string, string | undefined> = {
    ...process.env,
    GROK_FILE_ACCELERATION: 'false',
  };
  let prefix: string[] = [];
  if (process.platform === 'darwin') {
    const home =
      process.env.GROK_HOME ||
      path.join(process.env.HOME || fail('HOME is required'), '.grok');
    if (!path.isAbsolute(home) || !home.trim())
      fail('GROK_HOME must be absolute');
    const state = path.normalize(home);
    const profile = policy(cwd, binary, state);
    // -p passes policy as an argument. No writable profile file can be swapped.
    prefix = ['/usr/bin/sandbox-exec', '-p', profile.text];
    env.GROK_HOME = state;
    env.TMPDIR = profile.temp;
    const version = (
      await capture(
        [...prefix, binary, '--no-auto-update', '--version'],
        cwd,
        env,
      )
    ).trim();
    if (version !== VERIFIED_BUILD)
      fail(`unreviewed Grok build: ${version}; expected ${VERIFIED_BUILD}`);
    let inspected: any;
    try {
      inspected = JSON.parse(
        await capture(
          [
            ...prefix,
            binary,
            '--no-auto-update',
            '--no-leader',
            '--cwd',
            cwd,
            'inspect',
            '--json',
          ],
          cwd,
          env,
        ),
      );
    } catch {
      fail('cannot validate Grok configuration; no session started');
    }
    const layers = inspected.configSources?.layers;
    if (!Array.isArray(layers))
      fail('Grok inspect omitted configuration sources');
    const roles = new Set([
      'system-managed',
      'managed',
      'user',
      'system-requirements',
      'requirements',
      'mdm',
      'project',
      'env_overlay',
    ]);
    for (const layer of layers) {
      if (
        !roles.has(layer.role) ||
        (layer.note &&
          layer.note !== 'empty' &&
          !(
            layer.role === 'env_overlay' && layer.note.startsWith('sections: ')
          ))
      )
        fail('unknown or invalid configuration layer');
      if (
        ['system-requirements', 'requirements', 'mdm'].includes(layer.role) &&
        layer.note !== 'empty'
      )
        fail(
          'enforced requirements can override file acceleration; refusing external sandbox startup',
        );
    }
    args.push('--sandbox', 'off');
  } else args.push('--sandbox', 'read-only');
  const child = Bun.spawn([...prefix, binary, ...args], {
    cwd,
    env,
    stdin: 'inherit',
    stdout: 'inherit',
    stderr: 'inherit',
  });
  for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP'] as const)
    process.on(signal, () => child.kill(signal));
  const code = await child.exited;
  process.exit(code);
}
main().catch((error) => {
  console.error(`gstack-grok: ${error.message}`);
  process.exit(1);
});
